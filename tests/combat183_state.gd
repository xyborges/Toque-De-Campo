extends SceneTree
var failures: Array[String]=[]
var checks:=0
func _initialize() -> void: run.call_deferred()
func check(ok: bool,label: String) -> void:
	checks+=1;print(("PASS " if ok else "FAIL ")+label)
	if not ok: failures.append(label)
func run() -> void:
	var game=load("res://tests/combat_155_fixture.gd").new();game.set_meta("test_mode",true);root.add_child(game)
	game.profile.owned=["fal","glock"];game._begin_offline("desert",{"primary":"fal","sidearm":"glock","grenade":"grenade"})
	game.set_physics_process(false);game.ui_focus.close_all()
	var actor: GamePlayer=game.local_player;actor.set_physics_process(false)
	game.grenades_system.set_physics_process(false)
	actor.equip_slot(4);var fresh:=actor.shot_sequence;actor.fire_cooldown=0;actor.fire()
	check(actor.shot_sequence==fresh+1,"Glock fires in a fresh offline life")
	actor.weapon_id="fal";actor._refresh_weapon();actor.trigger_held=true
	actor.apply_reload_state("",0,0,{},actor.reload_revision)
	check(actor.trigger_held,"idle inventory acknowledgement preserves held automatic trigger")
	actor.begin_reload("fal",6)
	check(not actor.trigger_held,"actual reload still releases the trigger")
	actor.cancel_reload();actor.trigger_held=true;actor.apply_reload_state("fal",4,6,{},actor.reload_revision+1)
	check(not actor.trigger_held and actor.reload_weapon=="fal","authoritative reload start blocks firing")
	actor.cancel_reload()
	actor.equip_grenade();actor._physics_process(.016)
	check(actor.grenade_selected and actor.grenade_aiming,"unarmed grenade enables its preview")
	actor.equip_slot(6)
	check(not actor.grenade_selected and not actor.grenade_aiming,"returning to the same FAL clears grenade preview immediately")
	var before:=actor.shot_sequence;actor.fire_cooldown=0;actor.fire()
	check(actor.shot_sequence==before+1,"FAL fires after cancelling unarmed grenade selection")
	actor.equip_grenade();actor._physics_process(.016);actor.equip_slot(4)
	before=actor.shot_sequence;actor.fire_cooldown=0;actor.fire()
	check(actor.shot_sequence==before+1 and not actor.grenade_aiming,"offline Glock fires after cancelling grenade selection")
	actor.equip_slot(6)
	actor.equip_grenade();actor._physics_process(.016);game.prime_grenade(actor)
	check(not actor.grenade_held_id.is_empty(),"grenade is armed through the regular authority")
	before=actor.shot_sequence;actor.fire_cooldown=0;actor.fire()
	check(actor.shot_sequence==before,"armed grenade still blocks firearm")
	game.request_grenade(actor)
	check(actor.grenade_held_id.is_empty() and not actor.grenade_aiming and not actor.grenade_prime_pending,"throw clears preparation flags")
	check(actor.grenade_throw_left>0,"throw animation still prevents an immediate firearm shot")
	actor._physics_process(.8);actor.equip_slot(6);before=actor.shot_sequence;actor.fire_cooldown=0;actor.fire()
	check(actor.shot_sequence==before+1,"FAL fires after completed grenade throw")
	actor.grenade_aiming=true;actor.grenade_throw_left=.5;actor.hp=0;game._reset_server_player(actor)
	check(not actor.grenade_aiming and actor.grenade_throw_left==0,"authority clears grenade state on a new life")
	actor.grenade_throw_left=.5;game.remote_player_respawn(actor.peer_id,actor.global_position,actor.life_id+1)
	check(actor.grenade_throw_left==0,"respawn replication clears leftover throw animation")
	NavalStorage.write_json("res://tests/combat183-state-results.json",{"checks":checks,"failures":failures})
	game.show_menu();game.queue_free();await create_timer(.3).timeout;quit(0 if failures.is_empty() else 1)

