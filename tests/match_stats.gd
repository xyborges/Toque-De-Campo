extends SceneTree
var checks:=0
var failures: Array[String]=[]
func _initialize() -> void: run.call_deferred()
func check(ok: bool,message: String) -> void:
	checks+=1;print(("PASS " if ok else "FAIL ")+message)
	if not ok: failures.append(message)
func run() -> void:
	var stats:=GameMatchStats.new()
	for id in [1,2,3,4]: stats.register(id,"player"+str(id))
	stats.hit(1,3,1,30,false,false,20,1)
	stats.death(3,1);stats.death(3,1)
	stats.hit(2,3,1,70,true,true,150,2)
	check(stats.rows[2].points==150 and stats.rows[2].kills==1,"kill + headshot + long-range bonuses use verified conditions")
	check(stats.rows[1].points==50 and stats.rows[1].assists==1,"recent contribution earns one assist")
	check(stats.rows[3].deaths==1 and stats.rows[1].damage==30 and stats.rows[2].damage==70,"death deduplication and effective damage are recorded")
	stats.hit(2,3,1,1,true,true,150,2)
	check(stats.rows[2].points==150 and stats.rows[2].kills==1,"same life cannot award another elimination")
	stats.hit(1,4,1,30,false,false,10,1);stats.hit(2,4,1,70,true,false,10,12)
	check(stats.rows[1].assists==1 and stats.rows[2].points==250,"expired damage does not create an assist or extra kill bonuses")
	stats.hit(1,4,2,19,false,false,10,15);stats.hit(2,4,2,81,true,false,10,16)
	check(stats.rows[1].assists==1,"less than twenty actual HP does not earn an assist")
	stats.hit(1,1,1,100,true,true,200,20)
	check(stats.rows[1].kills==0,"suicide does not earn points or a kill")
	check(stats.award(1,150,"capture:A:1","objective") and not stats.award(1,150,"capture:A:1","objective"),"capture event is idempotent")
	check(stats.rows[1].objective==150,"objective points remain separate from damage and kill totals")
	check(stats.support(1,1,100,"heal",20,"self")==0,"self healing cannot farm points")
	check(stats.support(1,2,40,"heal",20,"heal1")==20 and stats.support(1,2,40,"heal",20,"heal1")==0,"actual ally healing is proportional and event-deduplicated")
	stats.support(1,2,100,"heal",21,"heal2")
	check(stats.rows[1].support==50,"support reward is capped per recipient per minute")
	check(stats.support(1,2,20,"heal",81,"heal3")==10,"support allowance renews after a minute")
	check(stats.support(1,2,0,"ammo",81,"full")==0,"full inventory cannot generate resupply points")
	var support_stats:=GameMatchStats.new()
	for id in [1,2,3]: support_stats.register(id,"ally"+str(id))
	check(support_stats.valid_damage(1,17.5) and support_stats.rows[1].damage==17.5 and support_stats.rows[1].kills==0 and support_stats.rows[1].assists==0,"effective vehicle damage can be recorded without inventing infantry eliminations or assists")
	var damage_revision:=support_stats.revision
	check(not support_stats.valid_damage(55,20) and not support_stats.valid_damage(1,0) and not support_stats.valid_damage(1,-5) and not support_stats.valid_damage(1,INF) and not support_stats.valid_damage(1,NAN) and support_stats.revision==damage_revision,"damage accounting rejects missing attackers and invalid or non-positive damage")
	check(support_stats.support(1,2,50,"ammo",1,"same-area-supply")==5 and support_stats.support(1,3,50,"ammo",1,"same-area-supply")==5,"one actual resupply event rewards each recipient independently")
	check(support_stats.support(1,2,8,"heal",1,"same-area-supply")==4,"healing and ammunition event namespaces do not collide")
	check(support_stats.support(1,2,1,"ammo",2,"fraction")==0,"sub-point support is accumulated without inventing a full point")
	for i in 30: support_stats.support(1,2,1,"ammo",2,"fraction")
	check(support_stats.rows[1].support==14 and is_equal_approx(support_stats.support_limits["1:2:ammo"].fraction,.1),"duplicate fractional events cannot accumulate reward credit")
	for i in 9: support_stats.support(1,2,1,"ammo",3+i,"fraction-"+str(i))
	check(support_stats.rows[1].support==15,"distinct fractional actions accumulate into one actual point")
	support_stats.support(1,2,1000000,"ammo",20,"large-supply")
	for i in 10: support_stats.support(1,2,1000000,"ammo",21,"capped-"+str(i))
	check(support_stats.support_limits["1:2:ammo"].points==50 and support_stats.support_limits["1:2:ammo"].fraction==0.0,"minute cap cannot retain an unbounded fractional balance")
	check(support_stats.support(1,2,10,"ammo",62,"renewed")==1,"minute renewal starts with no banked excess reward")
	for i in 600:
		support_stats.register(100+i,"temporary")
		support_stats.support(1,100+i,1,"ammo",63,"bounded-"+str(i))
	check(support_stats.support_limits.size()<=GameMatchStats.MAX_SUPPORT_RECORDS,"support accounting has a fixed record budget")
	support_stats.remove(1)
	check(support_stats.support_limits.is_empty(),"disconnect releases obsolete support bookkeeping")
	stats.remove(2);check(not stats.rows.has(2),"disconnect immediately removes scoreboard membership")
	var snapshot:=stats.snapshot();var received:=GameMatchStats.new();received.receive(snapshot)
	check(received.snapshot()==snapshot,"client scoreboard uses the authoritative snapshot")
	stats.clear();check(stats.rows.is_empty() and stats.events.is_empty() and stats.contributors.is_empty(),"round reset clears events and contributions")
	var game=load("res://tests/late_join_fixture.gd").new();game.set_meta("test_mode",true);root.add_child(game)
	game.mode="training";game.map_kind="sandbox";game._enter_match_world();game.set_physics_process(false);game.mode="pvp"
	var first: GamePlayer=game._spawn_player(1,true,false,Vector3(0,0,10))
	var second: GamePlayer=game._spawn_player(2,false,false,Vector3(4,0,10))
	var target: GamePlayer=game._spawn_player(3,false,false,Vector3(0,0,-20))
	for actor in [first,second,target]: actor.set_physics_process(false)
	game._apply_hit(1,{"collider":target.hit_regions.chest},30,"chest","fal")
	game._apply_hit(2,{"collider":target.hit_regions.head},10,"head","fal")
	check(target.hp==0 and game.match_stats.rows[2].kills==1 and game.match_stats.rows[3].deaths==1,"actual server hitbox path records a fatal headshot and death once")
	check(game.match_stats.rows[1].assists==1 and game.match_stats.rows[2].points==125,"actual combat emits assist and headshot scores")
	check(is_equal_approx(float(game.match_stats.rows[1].damage)+float(game.match_stats.rows[2].damage),100),"overkill damage is clamped to the actual health removed")
	game._apply_hit(2,{"collider":target.hit_regions.head},100,"head","fal")
	check(game.match_stats.rows[2].points==125,"dead hitbox cannot add score")
	var event:=InputEventKey.new();event.keycode=KEY_TAB;event.pressed=true
	game.scoreboard._input(event)
	check(game.scoreboard.visible and game.scoreboard.lines[0].text.contains("125"),"TAB displays server-ranked scoreboard")
	await create_timer(.15).timeout
	if DisplayServer.get_name()!="headless":
		RenderingServer.force_draw(false);root.get_texture().get_image().save_png("res://work/scoreboard-infantry.png")
	event.pressed=false;game.scoreboard._input(event)
	check(not game.scoreboard.visible,"releasing TAB immediately returns to combat")
	game.show_menu();game.queue_free();await process_frame;await process_frame
	var report: Dictionary={"checks":checks,"failures":failures}
	NavalStorage.write_json("res://tests/match-stats-results.json",report);print(JSON.stringify(report));quit(0 if failures.is_empty() else 1)
