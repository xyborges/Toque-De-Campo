#!/usr/bin/env python
import os

# Keep the large upstream godot-cpp build tree outside the game's Git worktree.
cpp_root = os.environ.get("GODOT_CPP_ROOT", r"C:\Users\Joao Borges\Documents\campo-native-tools\godot-cpp")
if not os.path.isfile(os.path.join(cpp_root, "SConstruct")):
    raise RuntimeError("Set GODOT_CPP_ROOT to an official godotengine/godot-cpp clone")
local_env = Environment(tools=["default"], PLATFORM="")
env = SConscript(os.path.join(cpp_root, "SConstruct"), {"api_version": 4.7, "env": local_env})
env.Append(CPPPATH=[Dir("src").abspath])
suffix = env["suffix"].replace(".dev", "").replace(".universal", "")
libname = "{}{}{}{}".format(env.subst("$SHLIBPREFIX"), "warpose", suffix, env.subst("$SHLIBSUFFIX"))
lib = env.SharedLibrary(os.path.join("bin", env["platform"], libname), source=Glob("src/*.cpp"))
Default(lib)
