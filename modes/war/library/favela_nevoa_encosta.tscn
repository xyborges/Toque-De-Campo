[gd_scene load_steps=4 format=3]

[sub_resource type="Shader" id="MistShader"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, cull_disabled, depth_draw_never, fog_disabled;
uniform vec4 mist_color : source_color = vec4(0.83, 0.87, 0.85, 0.13);
float hash21(vec2 p) { return fract(sin(dot(p,vec2(127.1,311.7))) * 43758.5453); }
float noise21(vec2 p) {
	vec2 i=floor(p),f=fract(p);
	f=f*f*(3.0-2.0*f);
	return mix(mix(hash21(i),hash21(i+vec2(1.0,0.0)),f.x),mix(hash21(i+vec2(0.0,1.0)),hash21(i+vec2(1.0,1.0)),f.x),f.y);
}
void fragment() {
	vec2 uv=UV;
	float mask=smoothstep(0.0,0.22,uv.x)*(1.0-smoothstep(0.78,1.0,uv.x));
	mask*=smoothstep(0.0,0.24,uv.y)*(1.0-smoothstep(0.70,1.0,uv.y));
	float vapor=noise21(uv*vec2(8.0,2.0))+0.35*noise21(uv*vec2(19.0,4.0));
	float fade=smoothstep(0.36,0.75,vapor);
	ALBEDO=mist_color.rgb;
	ALPHA=mist_color.a*mask*(0.4+0.6*fade);
}"

[sub_resource type="ShaderMaterial" id="MatNevoa"]
shader = SubResource("MistShader")

